{
  "$schema": "https://modelcontextprotocol.io/schema/mcp-config.schema.json",
  "mcpServers": {
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_FILE_PATH": ".claude/state/memory.jsonl"
      }
    },
    "supabase": {
      "command": "bash",
      "args": [
        "./scripts/mcp-wrappers/supabase-wrapper.sh"
      ]
    },
    "akg": {
      "command": "bun",
      "args": [
        "run",
        "packages/web/src/tools/akg/mcp/server.ts"
      ],
      "env": {
        "AKG_GRAPH_PATH": "docs/architecture/akg/graph/current.json",
        "AKG_DIAGRAMS_PATH": "docs/architecture/akg/diagrams",
        "AKG_PROJECT_ROOT": "."
      }
    },
    "cloudflare-docs": {
      "command": "bash",
      "args": [
        "./scripts/mcp-wrappers/cloudflare-wrapper.sh",
        "docs"
      ]
    },
    "cloudflare-bindings": {
      "command": "bash",
      "args": [
        "./scripts/mcp-wrappers/cloudflare-wrapper.sh",
        "bindings"
      ]
    },
    "cloudflare-observability": {
      "command": "bash",
      "args": [
        "./scripts/mcp-wrappers/cloudflare-wrapper.sh",
        "observability"
      ]
    },
    "cloudflare-builds": {
      "command": "bash",
      "args": [
        "./scripts/mcp-wrappers/cloudflare-wrapper.sh",
        "builds"
      ]
    },
    "cloudflare-logpush": {
      "command": "bash",
      "args": [
        "./scripts/mcp-wrappers/cloudflare-wrapper.sh",
        "logpush"
      ]
    },
    "cloudflare-graphql": {
      "command": "bash",
      "args": [
        "./scripts/mcp-wrappers/cloudflare-wrapper.sh",
        "graphql"
      ]
    }
  }
}

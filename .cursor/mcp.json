{
  "$schema": "https://modelcontextprotocol.io/schema/mcp-config.schema.json",
  "mcpServers": {
    "memory": {
      "command": "node",
      "args": [
        "${workspaceFolder}/node_modules/@modelcontextprotocol/server-memory/dist/index.js"
      ],
      "env": {
        "MEMORY_FILE_PATH": "${workspaceFolder}/.claude/state/memory.jsonl"
      }
    },
    "supabase": {
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/mcp-wrappers/supabase-wrapper.sh"
      ]
    },
    "akg": {
      "command": "bun",
      "args": [
        "run",
        "${workspaceFolder}/packages/web/src/tools/akg/mcp/server.ts"
      ],
      "env": {
        "AKG_GRAPH_PATH": "${workspaceFolder}/docs/architecture/akg/graph/current.json",
        "AKG_DIAGRAMS_PATH": "${workspaceFolder}/docs/architecture/akg/diagrams",
        "AKG_PROJECT_ROOT": "${workspaceFolder}"
      }
    },
    "cloudflare-docs": {
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/mcp-wrappers/cloudflare-wrapper.sh",
        "docs"
      ]
    },
    "cloudflare-bindings": {
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/mcp-wrappers/cloudflare-wrapper.sh",
        "bindings"
      ]
    },
    "cloudflare-observability": {
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/mcp-wrappers/cloudflare-wrapper.sh",
        "observability"
      ]
    },
    "cloudflare-builds": {
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/mcp-wrappers/cloudflare-wrapper.sh",
        "builds"
      ]
    },
    "cloudflare-logpush": {
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/mcp-wrappers/cloudflare-wrapper.sh",
        "logpush"
      ]
    },
    "cloudflare-graphql": {
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/mcp-wrappers/cloudflare-wrapper.sh",
        "graphql"
      ]
    }
  }
}

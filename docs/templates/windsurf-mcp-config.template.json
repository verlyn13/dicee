{
  "mcpServers": {
    "dicee-memory": {
      "command": "bash",
      "args": [
        "/absolute/path/to/dicee/scripts/mcp-wrappers/memory-wrapper.sh"
      ]
    },
    "dicee-akg": {
      "command": "bash",
      "args": [
        "/absolute/path/to/dicee/scripts/mcp-wrappers/akg-wrapper.sh"
      ]
    },
    "dicee-supabase": {
      "command": "bash",
      "args": [
        "/absolute/path/to/dicee/scripts/mcp-wrappers/supabase-wrapper.sh"
      ]
    },
    "dicee-cloudflare-docs": {
      "command": "bash",
      "args": [
